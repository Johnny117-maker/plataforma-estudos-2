# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC

# GROQ_API_KEY e GEMINI_API_KEY são secrets da Edge Function e NÃO entram aqui.
